POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neuroscan_db
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@neuroscan.local
PGADMIN_DEFAULT_PASSWORD=admin
AI_WORKER_PORT=8000
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=neuroscan_db;Username=postgres;Password=postgres
Redis__ConnectionString=localhost:6379
WEB_PORT=3000
VITE_API_PROXY_TARGET=http://localhost:5000
VNEID_PORT=5001
VNEID_CLIENT_ID=neuroscan-client
VNEID_CLIENT_SECRET=neuroscan-secret-key-123456

VNEID_REDIRECT_URI=http://localhost:3000/auth/callback
Vneid__Issuer=http://localhost:5001
Vneid__InternalBaseUrl=http://localhost:5001
Vneid__JwksCacheDurationMinutes=15
MockGov__BaseUrl=http://localhost:5001
MockGov__TimeoutSeconds=10
Frontend__Url=http://localhost:3000
Cors__AllowedOrigins__0=http://localhost:3000
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333

# RabbitMQ (required when running the rabbitmq service; pass via CLI or untracked .env — do not commit credentials)
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_USER=
RABBITMQ_PASS=
