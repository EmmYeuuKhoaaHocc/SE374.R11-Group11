{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=neuroscan_db;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Vneid": {
    "Issuer": "http://localhost:5001",
    "InternalBaseUrl": "http://localhost:5001",
    "ClientId": "neuroscan-client",
    "ClientSecret": "neuroscan-secret-key-123456",
    "JwksCacheDurationMinutes": 15
  },
  "MockGov": {
    "BaseUrl": "http://localhost:5001",
    "TimeoutSeconds": 10
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
